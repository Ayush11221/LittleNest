# ===========================================
# LittleNest — Environment Variables
# ===========================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# ===========================================

# Supabase
# Find these in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# AWS API Gateway (Phase 8+, leave empty for now)
VITE_API_URL=

# Razorpay
# Public key ID only — find it in: Razorpay Dashboard → Settings → API Keys
# NEVER put the key SECRET here or anywhere in frontend code; it must never
# ship to the browser. Use a test-mode key (rzp_test_...) during development.
VITE_RAZORPAY_KEY_ID=
